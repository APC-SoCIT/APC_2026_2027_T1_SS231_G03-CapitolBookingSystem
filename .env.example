# Frontend (Vite) — build-time, baked into the bundle
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Public URL of the Messenger webhook server. Leave unset when it runs on the
# same origin as the site (e.g. Railway), set to http://localhost:8000 for local dev.
VITE_WEBHOOK_URL=

# Messenger webhook server (webhook.js) — set in Railway service variables
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — server only, never expose to the browser
SUPABASE_SERVICE_KEY=your-service-role-key
# Google AI Studio key for the Gemini agent
GEMINI_API_KEY=your-gemini-api-key
# Messenger webhook verify token — must match the value in the Meta app dashboard
VERIFY_TOKEN=your-verify-token
# Facebook Page access token for the dummy/real page
META_PAGE_ACCESS_TOKEN=your-page-access-token
# Optional: outbound webhook (e.g. Discord/Slack) that pings staff on new inquiries
STAFF_NOTIFICATION_WEBHOOK_URL=
# Optional: CORS whitelist for the webhook server, comma-separated origins
FRONTEND_ORIGINS=
# Optional: overrides the public site URL used in bot messages (defaults to RAILWAY_PUBLIC_DOMAIN)
PUBLIC_SITE_URL=
# PayMongo secret key (sk_test_... for test mode, sk_live_... for real payments).
# When unset, GCash/Card checkout falls back to "payments not configured".
PAYMONGO_SECRET_KEY=
# PayMongo webhook signature secret (starts with whsec_) for /api/paymongo/webhook.
# Optional but recommended: unset skips signature verification.
PAYMONGO_WEBHOOK_SECRET=
